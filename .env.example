# Copia este archivo como ".env" para correr el proyecto en tu computador.
# En Render NO necesitas este archivo: las variables se configuran en el
# dashboard del servicio (render.yaml ya las declara).

# Cadena de conexión a Postgres. Si la dejas vacía / no defines esta variable,
# la app usa un archivo SQLite local (flota.db) solo para pruebas rápidas.
DATABASE_URL=postgresql://usuario:clave@localhost:5432/flota

# Cambia esto por un valor largo y aleatorio en producción.
SECRET_KEY=cambia-esto-por-un-valor-largo-y-aleatorio

# Minutos de duración de la sesión (1440 = 24 horas).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Credenciales del primer usuario administrador. Se crean automáticamente
# la primera vez que arranca la app (si la tabla de usuarios está vacía).
ADMIN_EMAIL=admin@tuempresa.com
ADMIN_PASSWORD=cambia-esta-clave
ADMIN_NAME=Administrador
